              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/request/verification": {
      "post": {
        "tags": ["Assets"],
        "summary": "Request property verification",
        "description": "Submit a property for verification",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["assetCode", "title", "body"],
                "properties": {
                  "assetCode": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "body": {
