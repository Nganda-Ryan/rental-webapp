          {
            "name": "Code",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "User code"
          },
          {
            "name": "Email",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "User email"
          },
          {
            "name": "Phone",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "User phone number"
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "description": "Create a new user account (admin/support only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstname", "lastname", "phone"],
                "properties": {
                  "email": {
                    "type": "string",
