      "post": {
        "tags": ["Payment"],
        "summary": "Confirm payment",
        "description": "Confirm and capture a PayPal payment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["executeURL", "token"],
                "properties": {
                  "executeURL": {
                    "type": "string",
                    "format": "uri"
                  },
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets": {
      "get": {
        "tags": ["Assets"],
        "summary": "Search assets",
        "description": "Search and filter properties/assets",
        "parameters": [
          {
            "name": "TypeCode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["CPLXMOD", "STUDMOD", "CHAMMOD", "APPART"]
            }
          },
          {
            "name": "City",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "profile",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["LANDLORD", "RENTER", "MANAGER"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assets retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Assets"],
        "summary": "Create asset",
        "description": "Create a new property/asset",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["asset", "coverFile"],
                "properties": {
                  "asset": {
                    "type": "object",
                    "description": "Asset data (JSON string)"
                  },
                  "coverFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "Cover image file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Asset created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "number",
                      "example": 200
                    },
                    "error": {
                      "type": "null"
                    },
                    "asset": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/{assetCode}": {
      "get": {
