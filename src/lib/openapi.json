    "/api/assets/attach": {
      "post": {
        "tags": ["Assets"],
        "summary": "Attach asset to complex",
        "description": "Attach a simple asset (studio/room) to a complex",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["simpleAssetCode", "complexAssetCode"],
                "properties": {
                  "simpleAssetCode": {
                    "type": "string"
                  },
                  "complexAssetCode": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Asset attached successfully",
