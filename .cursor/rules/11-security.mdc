# Security Best Practices

## Session Security

### HTTP-Only Cookies

**NEVER use localStorage or sessionStorage for tokens**:

```typescript
// ❌ NEVER do this
localStorage.setItem('token', token)
sessionStorage.setItem('user', JSON.stringify(user))

// ✅ ALWAYS use HTTP-only cookies
import { cookies } from 'next/headers'

const cookieStore = await cookies()
cookieStore.set('session', encryptedSession, {
  httpOnly: true,      // Not accessible via JavaScript
  secure: true,        // HTTPS only
  sameSite: 'lax',     // CSRF protection
  maxAge: 60 * 60,     // 1 hour
  path: '/'
})
```

### Session Verification

**ALWAYS verify session in Server Actions**:

```typescript
"use server"

import { verifySession } from '@/lib/session'

export async function protectedAction(data: any) {
  // 1. ALWAYS verify session first
  const session = await verifySession()

  if (!session) {
    return { success: false, error: 'Unauthorized' }
  }

  // 2. Continue with logic
  // ...
}
```

### JWT Best Practices

```typescript
// ✅ Use strong secret (256-bit minimum)
const AUTH_SECRET = process.env.AUTH_SECRET // Min 32 characters

// ✅ Set reasonable expiration
const payload = {
  user: userData,
  exp: Math.floor(Date.now() / 1000) + (60 * 60) // 1 hour
}

// ✅ Include necessary claims only
const session = {
  user: {
    Code: user.Code,
    Email: user.Email,
    Profiles: user.Profiles
  },
  accessToken: firebaseToken
}
// Don't include passwords, sensitive data
```

## Input Validation

### Server-Side Validation (Critical)

**NEVER trust client input** - Always validate on server:

```typescript
"use server"

export async function createProperty(formData: IPropertyForm) {
  const session = await verifySession()
  if (!session) return { success: false, error: 'Unauthorized' }

  // 1. Validate required fields
  if (!formData.Title || !formData.TypeCode) {
    return { success: false, error: 'Missing required fields' }
  }

  // 2. Validate field types
  if (typeof formData.Price !== 'number' || formData.Price < 0) {
    return { success: false, error: 'Invalid price' }
  }

  // 3. Validate enums
  const validTypes = ['CPLXMOD', 'STUDMOD', 'CHAMMOD', 'APPART']
  if (!validTypes.includes(formData.TypeCode)) {
    return { success: false, error: 'Invalid property type' }
  }

  // 4. Sanitize strings
  const sanitizedTitle = formData.Title.trim().substring(0, 100)

  // Continue...
}
```

### Client-Side Validation (UX only)

Client validation improves UX but is NOT security:

```typescript
"use client"

export function PropertyForm() {
  const [errors, setErrors] = useState<Record<string, string>>({})

  const validate = (data: IPropertyForm) => {
    const newErrors: Record<string, string> = {}

    if (!data.Title) newErrors.title = 'Title is required'
    if (!data.TypeCode) newErrors.type = 'Type is required'
    if (data.Price <= 0) newErrors.price = 'Price must be positive'

    setErrors(newErrors)
    return Object.keys(newErrors).length === 0
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()

    // Client validation for UX
    if (!validate(formData)) return

    // Server Action handles real security validation
    const result = await createProperty(formData)
  }
}
```

## File Upload Security

### Validation

```typescript
"use server"

import { uploadToR2 } from '@/lib/fileUpload'

export async function uploadFile(formData: FormData) {
  const session = await verifySession()
  if (!session) return { success: false, error: 'Unauthorized' }

  const file = formData.get('file') as File

  // 1. Validate file exists
  if (!file) {
    return { success: false, error: 'No file provided' }
  }

  // 2. Validate file size (100MB max)
  const MAX_SIZE = 100 * 1024 * 1024
  if (file.size > MAX_SIZE) {
    return { success: false, error: 'File too large (max 100MB)' }
  }

  // 3. Validate file type by extension
  const allowedExtensions = ['.png', '.jpg', '.jpeg', '.pdf', '.doc', '.docx']
  const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase()

  if (!allowedExtensions.includes(ext)) {
    return { success: false, error: 'Invalid file type' }
  }

  // 4. Validate MIME type
  const allowedMimeTypes = [
    'image/png',
    'image/jpeg',
    'application/pdf',
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
  ]

  if (!allowedMimeTypes.includes(file.type)) {
    return { success: false, error: 'Invalid file format' }
  }

  // 5. Sanitize filename
  const sanitizedFilename = file.name
    .replace(/[^a-zA-Z0-9.-]/g, '_')
    .substring(0, 255)

  try {
    const url = await uploadToR2(file, 'properties')
    return { success: true, data: { url } }
  } catch (error) {
    console.error('Upload error:', error)
    return { success: false, error: 'Upload failed' }
  }
}
```

