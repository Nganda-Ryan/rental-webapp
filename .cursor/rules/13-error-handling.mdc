## Validation Error Handling

### Field-Level Validation

```typescript
interface FieldErrors {
  [field: string]: string
}

export async function validatePropertyForm(data: IPropertyForm): Promise<FieldErrors> {
  const errors: FieldErrors = {}

  if (!data.Title || data.Title.trim().length === 0) {
    errors.title = 'Title is required'
  } else if (data.Title.length > 100) {
    errors.title = 'Title must be less than 100 characters'
  }

  if (!data.TypeCode) {
    errors.type = 'Property type is required'
  }

  if (data.Price <= 0) {
    errors.price = 'Price must be greater than 0'
  }

  return errors
}
```

### Display Field Errors

```typescript
"use client"

export function PropertyForm() {
  const [fieldErrors, setFieldErrors] = useState<FieldErrors>({})

  const handleSubmit = async (formData: IPropertyForm) => {
    // Validate
    const errors = await validatePropertyForm(formData)

    if (Object.keys(errors).length > 0) {
      setFieldErrors(errors)
      return
    }

    // Submit...
  }

  return (
    <form>
      <Input
        name="title"
        error={fieldErrors.title}
      />
      <Input
        name="price"
        type="number"
        error={fieldErrors.price}
      />
    </form>
  )
}
```

## API Error Handling

### Structured API Errors

```typescript
interface ApiError {
  code: string
  message: string
  field?: string
  details?: Record<string, any>
}

export async function handleApiError(response: Response): Promise<string> {
  try {
    const error: ApiError = await response.json()

    // Map API error codes to user-friendly messages
    const errorMessages: Record<string, string> = {
      'UNAUTHORIZED': 'You are not authorized to perform this action',
      'FORBIDDEN': 'You do not have permission to access this resource',
      'NOT_FOUND': 'The requested resource was not found',
      'VALIDATION_ERROR': error.message || 'Validation failed',
      'CONFLICT': 'This resource already exists',
      'RATE_LIMIT': 'Too many requests. Please try again later.'
    }

    return errorMessages[error.code] || error.message || 'An error occurred'
  } catch {
    // Response body is not JSON or empty
    return `Request failed with status ${response.status}`
  }
}
```

## Logging Errors

### Safe Error Logging

```typescript
function logError(error: unknown, context?: Record<string, any>) {
  const errorInfo = {
    message: error instanceof Error ? error.message : 'Unknown error',
    stack: error instanceof Error ? error.stack : undefined,
    context,
    timestamp: new Date().toISOString()
  }

  // ❌ Don't log sensitive data
  console.error('Error occurred:', errorInfo)

  // ✅ Send to error tracking service (Sentry, etc.)
  // reportToErrorService(errorInfo)
}

// Usage
try {
  await createProperty(data)
} catch (error) {
  logError(error, {
    action: 'createProperty',
    userCode: session.user.Code,
    // Don't include sensitive data like passwords, tokens
  })
}
```

## Retry Logic

### Simple Retry

```typescript
async function fetchWithRetry(
  url: string,
  options: RequestInit,
  maxRetries = 3
): Promise<Response> {
  let lastError: Error

  for (let i = 0; i < maxRetries; i++) {
    try {
      const response = await fetch(url, options)

      if (response.ok || response.status < 500) {
        // Don't retry client errors (4xx)
        return response
      }

      throw new Error(`HTTP ${response.status}`)
    } catch (error) {
      lastError = error as Error
      console.error(`Attempt ${i + 1} failed:`, error)

      if (i < maxRetries - 1) {
        // Exponential backoff
        await new Promise(resolve => setTimeout(resolve, Math.pow(2, i) * 1000))
      }
    }
  }

  throw lastError!
}
```

## Key Principles

1. **Consistent error structure** - Use ActionResult<T> pattern
2. **User-friendly messages** - Never expose technical details
3. **Log for debugging** - Console.error for developers
4. **Show errors to users** - Toast notifications or inline messages
5. **Handle all cases** - Loading, error, success, not found
6. **Validate early** - Both client and server
7. **Type errors** - Use Error types, not any
8. **Graceful degradation** - App should still work on error
9. **Retry transient failures** - Network errors, timeouts
10. **Monitor errors** - Track and fix common errors
