## Memoization

### React.memo for Component Memoization

```typescript
import { memo } from 'react'

// ✅ Memoize expensive components
export const PropertyCard = memo(function PropertyCard({ property }: Props) {
  return (
    <div>
      <h2>{property.Title}</h2>
      <p>{property.Price}</p>
    </div>
  )
})

// Only re-renders if property changes
```

### useMemo for Expensive Calculations

```typescript
"use client"

import { useMemo } from 'react'

export function PropertyList({ properties }: { properties: AssetData[] }) {
  // ✅ Memoize expensive calculations
  const sortedProperties = useMemo(() => {
    return [...properties].sort((a, b) => b.Price - a.Price)
  }, [properties])

  const totalValue = useMemo(() => {
    return properties.reduce((sum, p) => sum + p.Price, 0)
  }, [properties])

  return (
    <div>
      <p>Total Value: {totalValue}</p>
      {sortedProperties.map(p => <PropertyCard key={p.Code} property={p} />)}
    </div>
  )
}
```

### useCallback for Function Memoization

```typescript
"use client"

import { useCallback } from 'react'

export function PropertyManager({ properties }: Props) {
  // ✅ Memoize callbacks passed to child components
  const handleDelete = useCallback(async (code: string) => {
    await deleteProperty(code)
  }, [])

  return (
    <>
      {properties.map(p => (
        <PropertyCard
          key={p.Code}
          property={p}
          onDelete={handleDelete}
        />
      ))}
    </>
  )
}
```

## Database/API Optimization

### Request Deduplication

Next.js automatically deduplicates identical fetch requests:

```typescript
// Both components fetch same data
// Next.js makes only ONE request
async function Header() {
  const user = await fetch('/api/user').then(r => r.json())
  return <div>{user.name}</div>
}

async function Sidebar() {
  const user = await fetch('/api/user').then(r => r.json())
  return <div>{user.email}</div>
}
```

### Pagination

```typescript
"use client"

export function PropertyList() {
  const [page, setPage] = useState(1)
  const pageSize = 20

  const { properties, total } = await fetchProperties({
    page,
    pageSize
  })

  return (
    <div>
      {properties.map(p => <PropertyCard key={p.Code} property={p} />)}

      <Pagination
        current={page}
        total={Math.ceil(total / pageSize)}
        onChange={setPage}
      />
    </div>
  )
}
```

### Infinite Scroll

```typescript
"use client"

import { useEffect, useState } from 'react'

export function InfinitePropertyList() {
  const [properties, setProperties] = useState<AssetData[]>([])
  const [page, setPage] = useState(1)
  const [hasMore, setHasMore] = useState(true)

  const loadMore = async () => {
    const newProperties = await fetchProperties({ page, pageSize: 20 })

    if (newProperties.length === 0) {
      setHasMore(false)
      return
    }

    setProperties(prev => [...prev, ...newProperties])
    setPage(prev => prev + 1)
  }

  // Intersection Observer for auto-load
  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && hasMore) {
          loadMore()
        }
      },
      { threshold: 1.0 }
    )

    const sentinel = document.querySelector('#load-more-sentinel')
    if (sentinel) observer.observe(sentinel)

    return () => observer.disconnect()
  }, [hasMore])

  return (
    <div>
      {properties.map(p => <PropertyCard key={p.Code} property={p} />)}
      {hasMore && <div id="load-more-sentinel">Loading...</div>}
    </div>
  )
}
```

## Virtual Scrolling (Large Lists)

For extremely long lists (1000+ items):

```typescript
import { FixedSizeList } from 'react-window'

export function VirtualizedPropertyList({ properties }: Props) {
  const Row = ({ index, style }: { index: number, style: React.CSSProperties }) => (
    <div style={style}>
      <PropertyCard property={properties[index]} />
    </div>
  )

  return (
    <FixedSizeList
      height={600}
      itemCount={properties.length}
      itemSize={200}
      width="100%"
    >
      {Row}
    </FixedSizeList>
  )
}
```

## Debouncing & Throttling

### Debounce Search Input

```typescript
"use client"

import { useState, useEffect } from 'react'
import debounce from 'lodash/debounce'

export function PropertySearch() {
  const [query, setQuery] = useState('')
  const [results, setResults] = useState<AssetData[]>([])

  // ✅ Debounce search to avoid excessive API calls
  useEffect(() => {
    const debouncedSearch = debounce(async (searchQuery: string) => {
      if (!searchQuery) {
        setResults([])
        return
      }

      const data = await searchProperties(searchQuery)
      setResults(data)
    }, 300) // Wait 300ms after user stops typing

    debouncedSearch(query)

    return () => debouncedSearch.cancel()
  }, [query])

  return (
    <div>
      <input
        value={query}
        onChange={(e) => setQuery(e.target.value)}
        placeholder="Search properties..."
      />
      <SearchResults results={results} />
    </div>
  )
}
```

