## Code Formatting

### Indentation

- **2 spaces** (not tabs)
- Consistent across files

### Line Length

- **80-100 characters** preferred
- **120 characters** maximum
- Break long lines logically

### Blank Lines

```typescript
// ✅ Use blank lines to separate logical blocks
export function Component() {
  const [state, setState] = useState()

  useEffect(() => {
    // Effect logic
  }, [])

  const handleClick = () => {
    // Handler logic
  }

  return (
    <div>
      {/* JSX */}
    </div>
  )
}
```

### Trailing Commas

```typescript
// ✅ Use trailing commas
const obj = {
  name: 'John',
  age: 30,  // Trailing comma
}

const arr = [
  'one',
  'two',    // Trailing comma
]
```

### Quotes

```typescript
// ✅ Single quotes for strings
const name = 'John'
const message = 'Hello, world!'

// ✅ Backticks for template literals
const greeting = `Hello, ${name}!`

// ✅ Double quotes for JSX attributes
<input type="text" name="title" />
```

## Conditional Rendering

### Simple Conditions

```typescript
// ✅ Short-circuit evaluation
{isLoading && <Spinner />}
{error && <ErrorMessage error={error} />}

// ✅ Ternary for if/else
{isAuthenticated ? <Dashboard /> : <Login />}
```

### Complex Conditions

```typescript
// ✅ Extract to variable
const showActions = isOwner && !isArchived && hasPermission

return (
  <div>
    {showActions && <ActionButtons />}
  </div>
)

// ✅ Or use function
function canEdit() {
  return isOwner && !isArchived && hasPermission
}

return (
  <div>
    {canEdit() && <EditButton />}
  </div>
)
```

## Boolean Props

```typescript
// ✅ Explicit boolean props
<Button disabled={true} />
<Modal isOpen={true} />

// ✅ Shorthand when true
<Button disabled />
<Modal isOpen />

// ✅ Variable
<Button disabled={isPending} />
```

## Event Handlers

```typescript
// ✅ Inline for simple handlers
<button onClick={() => setIsOpen(true)}>Open</button>

// ✅ Named function for complex handlers
const handleSubmit = async (e: React.FormEvent) => {
  e.preventDefault()
  // Complex logic
}

<form onSubmit={handleSubmit}>

// ✅ Named for reusable handlers
const handleDelete = useCallback(async (id: string) => {
  // Delete logic
}, [])

{items.map(item => (
  <ItemCard key={item.id} onDelete={() => handleDelete(item.id)} />
))}
```

## Destructuring

```typescript
// ✅ Destructure props
export function PropertyCard({ property, onEdit, onDelete }: Props) {
  // Use property, onEdit, onDelete directly
}

// ✅ Destructure state
const { user, activeRole, setUser } = useRoleStore()

