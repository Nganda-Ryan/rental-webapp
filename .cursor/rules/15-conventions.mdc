# Coding Conventions

## Naming Conventions

### Components

```typescript
// ✅ PascalCase for components
PropertyCard.tsx
UserProfile.tsx
CreatePropertyModal.tsx

// Component naming
export function PropertyCard() { }
export default function PropertyCard() { }
```

### Functions & Variables

```typescript
// ✅ camelCase for functions and variables
function fetchUserData() { }
const userProfile = { }
let isActive = true

// ✅ Descriptive names
const propertyList = []  // Good
const arr = []           // Bad - not descriptive
```

### Constants

```typescript
// ✅ UPPER_SNAKE_CASE for constants
const MAX_FILE_SIZE = 100 * 1024 * 1024
const BILLING_ITEMS = ['WATER', 'ELEC', 'INTERNET', 'GAS', 'RENT']
const USER_ROLES = {
  ADMIN: 'ADMIN',
  LANDLORD: 'LANDLORD'
} as const
```

### Types & Interfaces

```typescript
// ✅ PascalCase with I prefix for interfaces (data models)
interface IUserData { }
interface IProperty { }
interface IContract { }

// ✅ PascalCase for types (no prefix)
type PropertyType = 'CPLXMOD' | 'STUDMOD'
type UserRole = 'ADMIN' | 'LANDLORD'
type ActionResult<T> = { success: boolean, data?: T }
```

### Files

```typescript
// Components: PascalCase
PropertyCard.tsx
UserMenu.tsx

// Utilities: kebab-case
file-upload.ts
date-utils.ts

// Actions: camelCase + Action suffix
assetAction.ts
userAction.ts

// Types: camelCase
user.ts
Property.ts
```

### Folders

```typescript
// kebab-case for folders
components/feature/properties/
lib/file-upload/
hooks/use-asset-details/
```

## Import Organization

### Order

```typescript
// 1. External dependencies (React, Next.js, libraries)
import { useState, useEffect } from 'react'
import Image from 'next/image'
import { toast } from 'sonner'

// 2. Internal dependencies - absolute imports (@/)
import { createProperty } from '@/actions/assetAction'
import { IPropertyForm } from '@/types/Property'
import { Button } from '@/components/common/Button'
import { useRoleStore } from '@/store/roleStore'

// 3. Relative imports (same directory or subdirectories)
import { PropertyCard } from './PropertyCard'
import { Filters } from './Filters'

// 4. Type-only imports (if separate)
import type { Property } from '@/types/Property'

// 5. Styles
import './styles.css'
```

### Grouping

```typescript
// ✅ Group related imports with blank lines
import { useState, useEffect, useCallback } from 'react'
import { useRouter, useParams } from 'next/navigation'

import { createProperty, updateProperty, deleteProperty } from '@/actions/assetAction'
import { fetchUser } from '@/actions/userAction'

import { PropertyCard } from './PropertyCard'
import { PropertyForm } from './PropertyForm'
```

### Aliases

```typescript
// ✅ Use @ alias for src imports
import { Button } from '@/components/common/Button'
import { verifySession } from '@/lib/session'

// ❌ Avoid relative paths for src
import { Button } from '../../../components/common/Button'
```

## Code Structure

### Component Structure

```typescript
"use client"

// 1. Imports
import { useState } from 'react'
import { createProperty } from '@/actions/assetAction'
import type { IPropertyForm } from '@/types/Property'

// 2. Types/Interfaces (component-specific)
interface PropertyFormProps {
  initialData?: Partial<IPropertyForm>
  onSuccess?: () => void
}

// 3. Component
export function PropertyForm({ initialData, onSuccess }: PropertyFormProps) {
  // a. Hooks
  const [formData, setFormData] = useState<IPropertyForm>(initialData || {})
  const [isPending, startTransition] = useTransition()

  // b. Event handlers
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    // Logic
  }

  const handleChange = (field: string, value: any) => {
    setFormData(prev => ({ ...prev, [field]: value }))
  }

  // c. Effects
  useEffect(() => {
    // Side effects
  }, [])

  // d. Render logic
  const isValid = formData.Title && formData.TypeCode

  // e. JSX
  return (
    <form onSubmit={handleSubmit}>
      {/* Content */}
    </form>
  )
}

// 4. Helper functions (outside component)
function validateForm(data: IPropertyForm): boolean {
  return data.Title && data.TypeCode
}
```

### Server Action Structure

```typescript
"use server"

// 1. Imports
import { verifySession } from '@/lib/session'
import { revalidatePath } from 'next/cache'
import type { IPropertyForm, AssetData } from '@/types/Property'

// 2. Types
interface ActionResult<T = unknown> {
  success: boolean
  data?: T
  error?: string
}

// 3. Main action
export async function createProperty(
  formData: IPropertyForm
): Promise<ActionResult<AssetData>> {
  // a. Authentication
  const session = await verifySession()
  if (!session) {
    return { success: false, error: 'Unauthorized' }
  }

  // b. Validation
  if (!formData.Title || !formData.TypeCode) {
    return { success: false, error: 'Missing required fields' }
  }

  // c. Business logic
  try {
    const response = await fetch(url, options)
    const data = await response.json()

    if (!response.ok) {
      return { success: false, error: data.message }
    }

    // d. Side effects (revalidation, etc.)
    revalidatePath('/landlord/properties')

    // e. Return result
    return { success: true, data }
  } catch (error) {
    console.error('Create property error:', error)
    return { success: false, error: 'Operation failed' }
  }
}

// 4. Helper functions
async function validatePropertyData(data: IPropertyForm): Promise<boolean> {
  // Validation logic
  return true
}
```

## Comments

### When to Comment

```typescript
// ✅ Complex business logic
// Calculate prorated amount based on move-in date
const proratedAmount = calculateProratedRent(
  monthlyRent,
  moveInDate,
  billingCycle
)

// ✅ Non-obvious workarounds
// Safari doesn't support lookbehind regex, use alternative approach
const pattern = /pattern/

// ✅ Important constraints
// Max 100MB enforced by Cloudflare Workers
const MAX_FILE_SIZE = 100 * 1024 * 1024
```

### When NOT to Comment

```typescript
// ❌ Obvious code
// Set user name
setUserName(name)

// ❌ Bad code that needs explanation
// TODO: This is a hack, refactor later
const result = hackyFunction()

// Instead, just write good code
const result = properFunction()
```

